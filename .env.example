# 複製成 .env 後填入金鑰（.env 不要上傳、不要給別人）
ANTHROPIC_API_KEY=
# 模型名稱，可改
CLAUDE_MODEL=claude-sonnet-5-5
PORT=3000
# 設為 1 強制使用內建示範課程（不呼叫 API、不花錢）
MOCK=0

# ---- 以下只有「放上雲端」才需要 ----
# 對外開放時設為 0.0.0.0（本機使用不用設）
# HOST=0.0.0.0
# 通關密碼。HOST 不是本機時【必填】，否則程式拒絕啟動
# ACCESS_CODE=
# 登入憑證的簽章用，隨便一長串亂碼（沒設則每次重啟都要重新登入）
# SESSION_SECRET=
# 費用保護：全站每天最多呼叫 AI 次數、每個來源每小時上限
# DAILY_LIMIT=200
# HOURLY_PER_IP=60
# 雲端請設 production（cookie 會加 Secure）
# NODE_ENV=production
